# Identite attendue de l'image. A adapter au depot du groupe.
# Toute image qui ne vient pas exactement de ce depot, de ce workflow
# et de cette branche est refusee.
SOURCE_REPO=github.com/ValRom28/s2-keyless-slsa
WORKFLOW_PATH=.github/workflows/release.yml
BRANCH=main
ALLOWED_EVENTS=push
# Version exacte du generateur SLSA approuve
BUILDER_ID=https://github.com/slsa-framework/slsa-github-generator/.github/workflows/generator_container_slsa3.yml@refs/tags/v2.1.0
OIDC_ISSUER=https://token.actions.githubusercontent.com
